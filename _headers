/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/frmt/assets/*
  Cache-Control: public, max-age=31536000, immutable

/modul8/assets/*
  Cache-Control: public, max-age=31536000, immutable

/cyano/assets/*
  Cache-Control: public, max-age=31536000, immutable

/harmony/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Immutable means immutable: a file under here must never be edited in place, only added beside
# the old one under a new name. Replacing dollop/assets/icon.png after this rule existed left the
# previous icon pinned at the edge and in every browser that had seen it, for a year, with no way
# to withdraw it. The current one is icon-2.png; the next is icon-3.png.
/dollop/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Served as UTF-8 text so crawlers read them inline instead of downloading them.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
